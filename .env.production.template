# =============================================================================
# NFL DJANGO ASSISTANT - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# 
# IMPORTANT SECURITY INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in ALL required values with your production settings
# 3. NEVER commit the actual .env.production file to version control
# 4. Ensure proper file permissions (600) for the .env file
# 5. Use strong, unique values for all secrets
#
# =============================================================================

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# CRITICAL: Generate a new secret key for production
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-production-key-here-change-this-immediately

# Debug mode (MUST be False in production)
DJANGO_DEBUG=False

# Allowed hosts (comma-separated list of your domain names/IPs)
# Examples: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
POSTGRES_DB=nfl_assistant_prod
POSTGRES_USER=nfl_user
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated list of frontend URLs)
# Examples: https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# NFL API KEYS AND EXTERNAL SERVICES
# =============================================================================

# ESPN API Key (if you have a premium account)
ESPN_API_KEY=your-espn-api-key-here

# NFL Official API Key (if available)
NFL_API_KEY=your-nfl-api-key-here

# Sleeper API Key (for fantasy data)
SLEEPER_API_KEY=your-sleeper-api-key-here

# FantasyPros API Key (if available)
FANTASYPROS_API_KEY=your-fantasypros-api-key-here

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================

# API Rate limits
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# NFL ASSISTANT CONFIGURATION
# =============================================================================

# Maximum number of players in rankings
NFL_MAX_RANKINGS=50

# Cache duration in seconds (21600 = 6 hours)
NFL_CACHE_DURATION=21600

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================

# Redis URL for caching (adjust host/port as needed)
# Format: redis://[password@]host:port/db_number
REDIS_URL=redis://127.0.0.1:6379/1

# For Redis with password:
# REDIS_URL=redis://username:password@redis-host:6379/1

# For Redis Cloud or managed service:
# REDIS_URL=redis://username:password@your-redis-cloud-endpoint:port/db

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Email Settings (for notifications, password resets, etc.)
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=nfl-assistant@yourdomain.com

# Common email providers:
# Gmail: smtp.gmail.com, port 587
# SendGrid: smtp.sendgrid.net, port 587
# Amazon SES: email-smtp.region.amazonaws.com, port 587

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Custom admin URL (change from default /admin/ for security)
ADMIN_URL=your-custom-admin-url-here/

# Health check URL
HEALTH_CHECK_URL=/health/

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Sentry DSN for error tracking (optional but recommended)
# Get from: https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL settings (usually handled by reverse proxy like nginx)
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================

# Database backup settings
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30

# Maintenance mode
MAINTENANCE_MODE=False

# =============================================================================
# DEPLOYMENT SPECIFIC
# =============================================================================

# Environment identifier
ENVIRONMENT=production

# Server timezone
TZ=UTC

# Worker processes for gunicorn/uwsgi
WEB_CONCURRENCY=4

# =============================================================================
# EXAMPLE VALUES FOR DEVELOPMENT/TESTING
# =============================================================================
# 
# For local testing with production settings, you can use:
# SECRET_KEY=django-insecure-test-key-do-not-use-in-production
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1
# POSTGRES_DB=nfl_assistant_test
# POSTGRES_USER=test_user
# POSTGRES_PASSWORD=test_password
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# REDIS_URL=redis://127.0.0.1:6379/2
#
# =============================================================================

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
#
# Before deploying to production, ensure:
# 
# ✅ SECRET_KEY is unique and secure (50+ characters)
# ✅ DJANGO_DEBUG is set to False
# ✅ ALLOWED_HOSTS contains only your actual domains
# ✅ Database password is strong and unique
# ✅ CORS_ALLOWED_ORIGINS contains only trusted frontend URLs
# ✅ SSL is configured (HTTPS only)
# ✅ All API keys are valid and from secure sources
# ✅ Email credentials are correct
# ✅ Redis is secured (password protected if accessible externally)
# ✅ Admin URL is changed from default
# ✅ File permissions are set correctly (600 for .env files)
# ✅ Regular backups are configured
# ✅ Monitoring/logging is set up
# ✅ Security headers are enabled
# ✅ Rate limiting is configured appropriately
#
# =============================================================================