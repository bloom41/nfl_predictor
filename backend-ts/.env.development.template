# NFL Predictor Backend - Development Environment Template
# 🔧 Safe for local development and version control

# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
# Use local PostgreSQL for development
DATABASE_URL="postgresql://nfl_user:nfl_password@localhost:5432/nfl_predictor_dev"
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=10

# Redis Configuration
# Use local Redis for development
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_CLUSTER_MODE=false
REDIS_TLS=false

# Security Configuration (DEVELOPMENT ONLY - NOT FOR PRODUCTION)
JWT_SECRET="dev-jwt-secret-32-chars-minimum-replace-in-production"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ML Service Configuration
ML_SERVICE_URL="http://localhost:5000"
ML_SERVICE_TIMEOUT=30000
ML_CACHE_TTL=3600

# External API Keys (Optional for development)
NFL_API_KEY=""
WEATHER_API_KEY=""

# Monitoring & Error Tracking (Optional for development)
SENTRY_DSN=""

# Performance Configuration
CACHE_DEFAULT_TTL=1800
DATABASE_QUERY_TIMEOUT=10000
API_RESPONSE_TIMEOUT=30000

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=debug

# Feature Flags
ENABLE_ML_PROJECTIONS=true
ENABLE_INJURY_ANALYSIS=true
ENABLE_WEATHER_INTEGRATION=false

# Development Setup Instructions:
# 1. Copy this file to .env
# 2. Install PostgreSQL and Redis locally
# 3. Create database: createdb nfl_predictor_dev
# 4. Update database credentials if needed
# 5. Start Redis server: redis-server