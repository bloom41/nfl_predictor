# NFL Predictor Backend - Test Environment Template
# 🧪 For automated testing and CI/CD pipelines

# Server Configuration
NODE_ENV=test
PORT=3002
API_VERSION=v1

# Database Configuration
# Use separate test database
DATABASE_URL="postgresql://test_user:test_password@localhost:5432/nfl_predictor_test"
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=5

# Redis Configuration
# Use separate Redis instance or different DB
REDIS_URL="redis://localhost:6380"
REDIS_PASSWORD=""
REDIS_CLUSTER_MODE=false
REDIS_TLS=false

# Security Configuration (TEST ONLY)
JWT_SECRET="test-jwt-secret-32-chars-minimum-for-testing"
CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# ML Service Configuration
ML_SERVICE_URL="http://localhost:5001"
ML_SERVICE_TIMEOUT=5000
ML_CACHE_TTL=300

# External API Keys (Mock/Test values)
NFL_API_KEY="test_nfl_api_key"
WEATHER_API_KEY="test_weather_api_key"

# Monitoring & Error Tracking (Disabled for tests)
SENTRY_DSN=""

# Performance Configuration (Faster for tests)
CACHE_DEFAULT_TTL=300
DATABASE_QUERY_TIMEOUT=5000
API_RESPONSE_TIMEOUT=10000

# Monitoring Configuration (Minimal for tests)
ENABLE_METRICS=false
METRICS_PORT=9091
LOG_LEVEL=error

# Feature Flags (Disabled for isolation)
ENABLE_ML_PROJECTIONS=false
ENABLE_INJURY_ANALYSIS=false
ENABLE_WEATHER_INTEGRATION=false

# Test Setup Instructions:
# 1. Copy this file to .env.test
# 2. Create test database: createdb nfl_predictor_test
# 3. Start Redis on port 6380: redis-server --port 6380
# 4. Run tests: npm test