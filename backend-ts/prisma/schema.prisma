generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NFLTeam {
  team_abbreviation String              @id @db.VarChar(3)
  full_name         String              @db.VarChar(100)
  city              String              @db.VarChar(50)
  conference        String              @db.VarChar(3)
  division          String              @db.VarChar(10)
  stadium           String?             @db.VarChar(100)
  head_coach        String?             @db.VarChar(100)
  last_updated      DateTime            @updatedAt @db.Timestamptz(6)
  players           CompleteNFLPlayer[]
  depth_charts      DepthChart[]
  transactions_from PlayerTransaction[] @relation("TransactionFromTeam")
  transactions_to   PlayerTransaction[] @relation("TransactionToTeam")

  @@index([team_abbreviation], map: "nfl_teams_team_abbreviation_47aa6085_like")
  @@map("nfl_teams")
}

model CompleteNFLPlayer {
  id                   BigInt              @id @default(autoincrement())
  player_id            String              @unique @db.VarChar(20)
  first_name           String              @db.VarChar(50)
  last_name            String              @db.VarChar(50)
  full_name            String              @db.VarChar(100)
  position             String              @db.VarChar(10)
  jersey_number        Int?
  height               String?             @db.VarChar(10)
  weight               Int?
  age                  Int?
  years_pro            Int?
  status               String              @db.VarChar(20)
  fantasy_relevant     Boolean
  depth_chart_position Int?
  college              String?             @db.VarChar(100)
  draft_year           Int?
  draft_round          Int?
  draft_pick           Int?
  created_at           DateTime            @db.Timestamptz(6)
  updated_at           DateTime            @updatedAt @db.Timestamptz(6)
  last_roster_update   DateTime?           @db.Timestamptz(6)
  team_id              String              @db.VarChar(3)
  team_ref             NFLTeam             @relation(fields: [team_id], references: [team_abbreviation], onDelete: NoAction, onUpdate: NoAction, map: "complete_nfl_players_team_id_8328caab_fk_nfl_teams")
  depth_charts         DepthChart[]
  transactions         PlayerTransaction[]
  season_stats         SeasonStats[]

  @@index([depth_chart_position], map: "complete_nf_depth_c_938a10_idx")
  @@index([last_roster_update], map: "complete_nf_last_ro_041ce9_idx")
  @@index([position, fantasy_relevant], map: "complete_nf_positio_8039a0_idx")
  @@index([status], map: "complete_nf_status_5d5a90_idx")
  @@index([team_id, position], map: "complete_nf_team_id_c63640_idx")
  @@index([player_id], map: "complete_nfl_players_player_id_c138518e_like")
  @@index([team_id], map: "complete_nfl_players_team_id_8328caab")
  @@index([team_id], map: "complete_nfl_players_team_id_8328caab_like")
  @@map("complete_nfl_players")
}

model PlayerTransaction {
  id               BigInt            @id @default(autoincrement())
  transaction_type String            @db.VarChar(20)
  transaction_date DateTime          @db.Timestamptz(6)
  details          String?
  source           String?           @db.VarChar(100)
  created_at       DateTime          @db.Timestamptz(6)
  from_team_id     String?           @db.VarChar(3)
  player_id        BigInt
  to_team_id       String?           @db.VarChar(3)
  from_team_ref    NFLTeam?          @relation("TransactionFromTeam", fields: [from_team_id], references: [team_abbreviation], onDelete: NoAction, onUpdate: NoAction, map: "player_transactions_from_team_id_2c48ba9a_fk_nfl_teams")
  player           CompleteNFLPlayer @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "player_transactions_player_id_dd907966_fk_complete_")
  to_team_ref      NFLTeam?          @relation("TransactionToTeam", fields: [to_team_id], references: [team_abbreviation], onDelete: NoAction, onUpdate: NoAction, map: "player_transactions_to_team_id_2410b57f_fk_nfl_teams")

  @@index([player_id, transaction_date], map: "player_tran_player__1a78bd_idx")
  @@index([transaction_date], map: "player_tran_transac_17a887_idx")
  @@index([transaction_type], map: "player_tran_transac_464274_idx")
  @@index([from_team_id], map: "player_transactions_from_team_id_2c48ba9a")
  @@index([from_team_id], map: "player_transactions_from_team_id_2c48ba9a_like")
  @@index([player_id], map: "player_transactions_player_id_dd907966")
  @@index([to_team_id], map: "player_transactions_to_team_id_2410b57f")
  @@index([to_team_id], map: "player_transactions_to_team_id_2410b57f_like")
  @@map("player_transactions")
}

model InjuryReport {
  id                 Int       @id @default(autoincrement())
  player_id          Int
  player_name        String    @db.VarChar(100)
  team               String    @db.VarChar(10)
  position           String    @db.VarChar(10)
  week               Int
  season             Int
  injury_status      String?   @db.VarChar(20)
  injury_description String?
  date_reported      DateTime? @db.Timestamp(6)
  source             String?   @db.VarChar(100)

  @@map("injury_reports")
}

model DepthChart {
  id           BigInt            @id @default(autoincrement())
  position     String            @db.VarChar(10)
  depth_order  Int
  week         Int
  season       Int
  last_updated DateTime          @updatedAt @db.Timestamptz(6)
  player_id    BigInt
  team_id      String            @db.VarChar(3)
  player       CompleteNFLPlayer @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "depth_charts_player_id_fef981e2_fk_complete_nfl_players_id")
  team_ref     NFLTeam           @relation(fields: [team_id], references: [team_abbreviation], onDelete: NoAction, onUpdate: NoAction, map: "depth_charts_team_id_912084ea_fk_nfl_teams_team_abbreviation")

  @@unique([team_id, position, player_id, week, season], map: "depth_charts_team_id_position_player__89fab289_uniq")
  @@index([depth_order], map: "depth_chart_depth_o_f81439_idx")
  @@index([team_id, position, week, season], map: "depth_chart_team_id_f4eafd_idx")
  @@index([player_id], map: "depth_charts_player_id_fef981e2")
  @@index([team_id], map: "depth_charts_team_id_912084ea")
  @@index([team_id], map: "depth_charts_team_id_912084ea_like")
  @@map("depth_charts")
}

model SeasonStats {
  id                      BigInt            @id @default(autoincrement())
  season                  Int
  week                    Int
  passing_attempts        Int
  passing_completions     Int
  passing_yards           Int
  passing_touchdowns      Int
  interceptions           Int
  sacks_taken             Int
  rushing_attempts        Int
  rushing_yards           Int
  rushing_touchdowns      Int
  fumbles                 Int
  targets                 Int
  receptions              Int
  receiving_yards         Int
  receiving_touchdowns    Int
  kick_return_yards       Int
  punt_return_yards       Int
  fantasy_points_standard Float
  fantasy_points_half_ppr Float
  fantasy_points_ppr      Float
  created_at              DateTime          @db.Timestamptz(6)
  player_id               BigInt
  player                  CompleteNFLPlayer @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "season_stats_player_id_62effea4_fk_complete_nfl_players_id")

  @@unique([player_id, season, week], map: "season_stats_player_id_season_week_0e3b41d7_uniq")
  @@index([player_id, season], map: "season_stat_player__c0fa99_idx")
  @@index([season, week], map: "season_stat_season_145d2a_idx")
  @@index([player_id], map: "season_stats_player_id_62effea4")
  @@map("season_stats")
}

model Player {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  team       String    @db.VarChar(10)
  position   String    @db.VarChar(10)
  season     Int
  active     Boolean?
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)

  @@map("players")
}

model Prediction {
  id               Int       @id @default(autoincrement())
  player_id        Int
  player_name      String    @db.VarChar(100)
  team             String    @db.VarChar(10)
  position         String    @db.VarChar(10)
  week             Int
  season           Int
  predicted_points Float
  confidence       Float
  scoring_format   String?   @db.VarChar(20)
  model_version    String?   @db.VarChar(50)
  created_at       DateTime? @db.Timestamp(6)

  @@map("predictions")
}

model GameResult {
  id                      Int       @id @default(autoincrement())
  player_id               Int
  player_name             String    @db.VarChar(100)
  team                    String    @db.VarChar(10)
  position                String    @db.VarChar(10)
  week                    Int
  season                  Int
  actual_points           Float
  fantasy_points_ppr      Float?
  fantasy_points_half_ppr Float?
  fantasy_points_standard Float?
  passing_yards           Int?
  passing_tds             Int?
  passing_attempts        Int?
  passing_completions     Int?
  interceptions           Int?
  rushing_yards           Int?
  rushing_tds             Int?
  rushing_attempts        Int?
  receiving_yards         Int?
  receiving_tds           Int?
  receptions              Int?
  targets                 Int?
  created_at              DateTime? @db.Timestamp(6)

  @@map("game_results")
}

model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique @db.VarChar(150)
  auth_group_permissions auth_group_permissions[]
  auth_user_groups       auth_user_groups[]

  @@index([name], map: "auth_group_name_a6ea08ec_like")
}

