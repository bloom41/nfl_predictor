# NFL Predictor Backend - Production Environment Template
# 🔒 SECURITY WARNING: This file contains production configuration templates
# ⚠️  Replace all placeholder values with actual secrets from your secrets manager

# Server Configuration
NODE_ENV=production
PORT=3001
API_VERSION=v1

# Database Configuration
# Use AWS RDS, Azure Database, or similar managed service
DATABASE_URL="${DATABASE_URL_FROM_SECRETS_MANAGER}"
POSTGRES_SSL=true
POSTGRES_MAX_CONNECTIONS=20

# Redis Configuration
# Use AWS ElastiCache, Azure Cache, or similar managed service
REDIS_URL="${REDIS_URL_FROM_SECRETS_MANAGER}"
REDIS_PASSWORD="${REDIS_PASSWORD_FROM_SECRETS_MANAGER}"
REDIS_CLUSTER_MODE=true
REDIS_TLS=true

# Security Configuration
# Generate secure JWT secret: openssl rand -base64 64
JWT_SECRET="${JWT_SECRET_FROM_SECRETS_MANAGER}"
CORS_ORIGINS="https://nflpredictor.com,https://www.nflpredictor.com,https://api.nflpredictor.com"
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ML Service Configuration
ML_SERVICE_URL="http://ml-service:5000"
ML_SERVICE_TIMEOUT=30000
ML_CACHE_TTL=3600

# External API Keys
NFL_API_KEY="${NFL_API_KEY_FROM_SECRETS_MANAGER}"
WEATHER_API_KEY="${WEATHER_API_KEY_FROM_SECRETS_MANAGER}"

# Monitoring & Error Tracking
SENTRY_DSN="${SENTRY_DSN_FROM_SECRETS_MANAGER}"

# Performance Configuration
CACHE_DEFAULT_TTL=1800
DATABASE_QUERY_TIMEOUT=10000
API_RESPONSE_TIMEOUT=30000

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=info

# Feature Flags
ENABLE_ML_PROJECTIONS=true
ENABLE_INJURY_ANALYSIS=true
ENABLE_WEATHER_INTEGRATION=true

# Instructions for Deployment:
# 1. Copy this file to .env.production
# 2. Replace all ${VAR_FROM_SECRETS_MANAGER} with actual values
# 3. Store sensitive values in AWS Secrets Manager, Azure Key Vault, or similar
# 4. Never commit .env.production to version control
# 5. Use environment-specific CI/CD variables for deployment