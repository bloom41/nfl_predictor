# NFL Predictor Backend Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (for future use)
DATABASE_URL="postgresql://username:password@localhost:5432/nfl_predictor"

# Redis Configuration (for caching)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# API Configuration
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET="your-jwt-secret-key-here"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# External APIs (for future ML model integration)
NFL_API_KEY=""
WEATHER_API_KEY=""

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_ML_PROJECTIONS=true
ENABLE_INJURY_ANALYSIS=true
ENABLE_WEATHER_INTEGRATION=false