# NFL Assistant Environment Configuration

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nfl_assistant
POSTGRES_USER=nfl_user
POSTGRES_PASSWORD=nfl_secure_password_2024

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Application Settings
NFL_CACHE_DURATION=21600
NFL_MAX_RANKINGS=50
NFL_API_TIMEOUT=30
NFL_RATE_LIMIT=100

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nfl_assistant.log