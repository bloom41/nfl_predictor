#!/bin/bash
# NFL Predictor Commit Message Hook
# Validates commit message format and content

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

# Skip validation for merge commits, revert commits, etc.
if [[ "$commit_msg" =~ ^Merge|^Revert|^fixup!|^squash! ]]; then
    exit 0
fi

# Check if commit message is empty or just whitespace
if [[ -z "$(echo "$commit_msg" | tr -d '[:space:]')" ]]; then
    print_error "Commit message cannot be empty"
    exit 1
fi

# Extract the first line (subject)
subject=$(echo "$commit_msg" | head -n1)

# Check conventional commit format
conventional_pattern="^(feat|fix|docs|style|refactor|perf|test|chore|ci|security|build|revert)(\(.+\))?: .+"

if [[ ! "$subject" =~ $conventional_pattern ]]; then
    print_error "Commit message doesn't follow conventional commit format"
    echo ""
    echo "Expected format: type(scope): description"
    echo ""
    echo "Valid types:"
    echo "  feat:     New feature"
    echo "  fix:      Bug fix"
    echo "  docs:     Documentation changes"
    echo "  style:    Code style changes"
    echo "  refactor: Code refactoring"
    echo "  perf:     Performance improvements"
    echo "  test:     Adding or updating tests"
    echo "  chore:    Maintenance tasks"
    echo "  ci:       CI/CD changes"
    echo "  security: Security-related changes"
    echo "  build:    Build system changes"
    echo "  revert:   Reverting previous commits"
    echo ""
    echo "Examples:"
    echo "  feat(backend): add JWT authentication"
    echo "  fix(frontend): resolve login form validation"
    echo "  docs: update API documentation"
    echo "  security(config): encrypt environment variables"
    echo ""
    exit 1
fi

# Check subject line length
if [[ ${#subject} -gt 72 ]]; then
    print_error "Subject line too long (${#subject} chars). Keep it under 72 characters."
    exit 1
fi

if [[ ${#subject} -gt 50 ]]; then
    print_warning "Subject line is long (${#subject} chars). Consider keeping it under 50 characters."
fi

# Check if subject ends with a period
if [[ "$subject" =~ \.$  ]]; then
    print_error "Subject line should not end with a period"
    exit 1
fi

# Check if subject starts with capital letter (after type)
description_part=$(echo "$subject" | sed -E 's/^[a-z]+(\(.+\))?: //')
if [[ ! "$description_part" =~ ^[A-Z] ]]; then
    print_warning "Consider starting the description with a capital letter"
fi

# Check for imperative mood (common patterns)
if [[ "$description_part" =~ ^(added|fixed|updated|removed|deleted|changed) ]]; then
    print_warning "Use imperative mood (add, fix, update) instead of past tense (added, fixed, updated)"
fi

# Security checks
if echo "$commit_msg" | grep -qi "password\|secret\|key\|token\|api_key"; then
    print_error "Commit message contains potential secret information"
    print_warning "Avoid including sensitive information in commit messages"
    exit 1
fi

# Check for TODO/FIXME in commit message
if echo "$commit_msg" | grep -qi "todo\|fixme\|hack"; then
    print_warning "Commit message contains TODO/FIXME/HACK - consider addressing before committing"
fi

print_success "Commit message format is valid"