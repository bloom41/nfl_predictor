#!/bin/bash
# NFL Predictor Pre-commit Hook
# Runs security checks, linting, and type checking before commits

set -e

echo "🔍 Running pre-commit checks for NFL Predictor..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

# Check if we're in the right directory
if [[ ! -f "package.json" && ! -f "backend-ts/package.json" ]]; then
    print_error "Not in NFL Predictor project root"
    exit 1
fi

# 1. Security Checks
echo "🔒 Running security checks..."

# Check for secrets in staged files
if git diff --staged --name-only | xargs grep -l "password\|secret\|key\|token" 2>/dev/null; then
    print_error "Potential secrets found in staged files!"
    print_warning "Review the following files for hardcoded secrets:"
    git diff --staged --name-only | xargs grep -l "password\|secret\|key\|token" 2>/dev/null || true
    echo "If these are false positives, you can skip this check with: git commit --no-verify"
    exit 1
fi

# Check for .env files being committed
if git diff --staged --name-only | grep -E "\.env$|\.env\.production$|\.env\.staging$" 2>/dev/null; then
    print_error "Environment files should not be committed!"
    print_warning "The following environment files are staged:"
    git diff --staged --name-only | grep -E "\.env$|\.env\.production$|\.env\.staging$" || true
    echo "Use 'git reset HEAD <file>' to unstage these files"
    exit 1
fi

print_status "Security checks passed"

# 2. Backend TypeScript Checks
if [[ -d "backend-ts" ]]; then
    echo "🔧 Checking backend TypeScript..."
    cd backend-ts
    
    # Check if package.json exists and has scripts
    if [[ -f "package.json" ]]; then
        # Type checking
        if npm run typecheck > /dev/null 2>&1; then
            print_status "TypeScript compilation successful"
        else
            print_error "TypeScript compilation failed"
            echo "Run 'npm run typecheck' to see detailed errors"
            exit 1
        fi
        
        # Build check
        if npm run build > /dev/null 2>&1; then
            print_status "Build successful"
        else
            print_error "Build failed"
            echo "Run 'npm run build' to see detailed errors"
            exit 1
        fi
        
        # Configuration validation
        if npm run config:validate > /dev/null 2>&1; then
            print_status "Configuration validation passed"
        else
            print_warning "Configuration validation failed (this might be expected in development)"
        fi
    fi
    
    cd ..
fi

# 3. Frontend Checks (if frontend exists)
if [[ -d "frontend/client" ]]; then
    echo "⚛️  Checking frontend..."
    cd frontend/client
    
    if [[ -f "package.json" ]]; then
        # Type checking for frontend
        if npm run typecheck > /dev/null 2>&1; then
            print_status "Frontend TypeScript compilation successful"
        else
            print_warning "Frontend TypeScript compilation failed (continuing...)"
        fi
    fi
    
    cd ../..
fi

# 4. Python/ML Checks (if applicable)
if [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
    echo "🐍 Checking Python code..."
    
    # Check for Python syntax errors
    if command -v python3 &> /dev/null; then
        if find . -name "*.py" -exec python3 -m py_compile {} \; 2>/dev/null; then
            print_status "Python syntax check passed"
        else
            print_error "Python syntax errors found"
            exit 1
        fi
    fi
fi

# 5. Check for large files
echo "📦 Checking for large files..."
large_files=$(git diff --staged --name-only | xargs ls -la 2>/dev/null | awk '$5 > 10485760 {print $9 " (" $5 " bytes)"}' || true)
if [[ -n "$large_files" ]]; then
    print_warning "Large files detected (>10MB):"
    echo "$large_files"
    print_warning "Consider using Git LFS for large files"
fi

# 6. Check commit message format (if available)
if [[ -n "$1" ]]; then
    commit_msg="$1"
    if [[ ! "$commit_msg" =~ ^(feat|fix|docs|style|refactor|perf|test|chore|ci|security)(\(.+\))?: .{1,50}$ ]]; then
        print_warning "Commit message doesn't follow conventional format"
        print_warning "Format: type(scope): description"
        print_warning "Example: feat(backend): add user authentication"
    fi
fi

print_status "All pre-commit checks passed!"
echo "🚀 Ready to commit!"